# Copy to .env and fill in. Generate each secret with:  openssl rand -hex 32
# Variable names use underscores only – hyphens are not allowed in names.

MYSQL_ROOT_PASSWORD=

# Must match the user created by ./config/mysql/docker-entrypoint-initdb.d/*.sql
ONLYOFFICE_DB_USER=
ONLYOFFICE_DB_PASSWORD=

# Shared between community server and control panel
ONLYOFFICE_MACHINEKEY=

# Shared between community server and document server
ONLYOFFICE_JWT_SECRET=
